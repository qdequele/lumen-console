# Supabase project (local stack: `supabase start` prints these).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Service role / secret key — server-side only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Seals gateway master keys (AES-256-GCM) before they are stored in
# gateway_secrets. Generate with: openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=
